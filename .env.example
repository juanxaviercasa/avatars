# =====================================================================
# ViralForge Studio - configuración
# Copia este archivo como `.env` y rellena sólo lo que vayas a usar.
# TODO es opcional: sin ninguna clave el sistema funciona en modo CPU
# (guiones por plantillas + voz edge-tts + render FFmpeg propio).
# =====================================================================

# --- Servidor -----------------------------------------------------------
VF_HOST=127.0.0.1
VF_PORT=8765
VF_WORKERS=2                 # renders en paralelo
VF_RENDER_WIDTH=1080
VF_RENDER_HEIGHT=1920
VF_RENDER_FPS=30
VF_LANGUAGE=es               # idioma por defecto de guiones (es / en / pt)

# --- LLM (guiones y ganchos). Elige UNO: none | openai | gemini ----------
# "openai" sirve para cualquier API compatible: OpenAI, OpenRouter, Groq,
# DeepSeek, Ollama (http://localhost:11434/v1), LM Studio, vLLM...
VF_LLM_PROVIDER=none
VF_LLM_BASE_URL=https://api.openai.com/v1
VF_LLM_API_KEY=
VF_LLM_MODEL=gpt-4o-mini
GEMINI_API_KEY=
VF_GEMINI_MODEL=gemini-2.0-flash

# --- Motores GPU locales / remotos (opcionales) ------------------------
# ComfyUI (InstantID / PuLID / IDM-VTON / Flux) -> http://127.0.0.1:8188
VF_COMFYUI_URL=
# Servidor F5-TTS (Gradio) para clonación de voz -> http://127.0.0.1:7860
VF_F5TTS_URL=
# Servidor de lip-sync propio (ver engines/lipsync.py: contrato HTTP simple)
VF_LIPSYNC_URL=
# Nodo GPU OpenJutsu / Kaggle Cloudflare Tunnel -> https://xxxx.trycloudflare.com
VF_OPENJUTSU_URL=

# --- Clúster Kaggle (ABDM) & Oracle Cloud VPS (opcionales) --------------
VF_ABDM_DIR=C:\Users\cabel\Music\ABDM
VF_SSH_KEY_PATH=C:\Users\cabel\Music\claves_ssh\ssh-key-2026-08-30.key
VF_ORACLE_HOST=147.15.95.128

# --- Motores en la nube (opcionales, sin GPU propia) --------------------
# fal.ai aloja versiones de LivePortrait, MuseTalk, IDM-VTON, Flux-PuLID...
FAL_KEY=
VF_FAL_MODEL_FACE=fal-ai/flux-pulid
VF_FAL_MODEL_TRYON=fal-ai/idm-vton
VF_FAL_MODEL_LIPSYNC=fal-ai/sync-lipsync
VF_FAL_MODEL_TTS=fal-ai/f5-tts

# --- Shopify (opcional: las tiendas públicas no necesitan token) --------
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
